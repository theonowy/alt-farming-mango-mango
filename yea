local targetUserId = nil
local isScriptActive = false
local monitorCoroutine = nil

local function waitForTargetToJoin()
while isScriptActive do
local p = Players:GetPlayerByUserId(targetUserId)
if p then
return p
end
local got = nil
local conn
conn = Players.PlayerAdded:Connect(function(pl)
if pl.UserId == targetUserId then
got = pl
if conn then conn:Disconnect() end
end
end)
repeat
if not isScriptActive then
if conn then conn:Disconnect() end
return nil
end
local check = Players:GetPlayerByUserId(targetUserId)
if check then
got = check
if conn then conn:Disconnect() end
break
end
task.wait(0.5)
until got
if got then return got end
end
return nil
end

local function monitorTargetPlayer()
if not targetUserId then return end

local targetPlayer = Players:GetPlayerByUserId(targetUserId)
if not targetPlayer then
targetPlayer = waitForTargetToJoin()
if not targetPlayer then
return
end
end

local function bindCharacter(character)
if not character then return end
local humanoid = character:FindFirstChildOfClass("Humanoid") or character:FindFirstChild("Humanoid")
if humanoid then
humanoid.Died:Connect(function()
if player.Character and player.Character:FindFirstChildOfClass("Humanoid") and player.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
task.wait(2)
nuclearReset()
end
end)
end
end

if targetPlayer.Character then bindCharacter(targetPlayer.Character) end
targetPlayer.CharacterAdded:Connect(bindCharacter)

while isScriptActive do
if not Players:GetPlayerByUserId(targetUserId) then
local back = waitForTargetToJoin()
if not back then break end
targetPlayer = back
if targetPlayer.Character then bindCharacter(targetPlayer.Character) end
targetPlayer.CharacterAdded:Connect(bindCharacter)
else
local tp = Players:GetPlayerByUserId(targetUserId)
if tp and tp.Character then
local humanoid = tp.Character:FindFirstChildOfClass("Humanoid") or tp.Character:FindFirstChild("Humanoid")
if humanoid and humanoid.Health <= 0 then
if player.Character and player.Character:FindFirstChildOfClass("Humanoid") and player.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
task.wait(2)
nuclearReset()
end
repeat task.wait(0.2) until (Players:GetPlayerByUserId(targetUserId) and Players:GetPlayerByUserId(targetUserId).Character and Players:GetPlayerByUserId(targetUserId).Character:FindFirstChildOfClass("Humanoid") and Players:GetPlayerByUserId(targetUserId).Character:FindFirstChildOfClass("Humanoid").Health > 0) or not isScriptActive
end
end
task.wait(0.12)
end
end
end

